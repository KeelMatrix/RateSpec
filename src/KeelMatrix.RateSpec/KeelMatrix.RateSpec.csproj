<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- RateSpec validates the current ASP.NET Core rate-limiting pipeline and intentionally follows the net8.0 API surface. -->
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IsTestProject>false</IsTestProject>
    <PackageId>KeelMatrix.RateSpec</PackageId>
    <Description>Verify ASP.NET Core rate-limit bursts, rejection, and partition isolation with deterministic integration tests.</Description>
    <PackageTags>aspnetcore;rate-limiting;ratelimiter;testing;http;api;integration-testing</PackageTags>
    <EnablePublicApiAnalyzers>true</EnablePublicApiAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="KeelMatrix.Telemetry" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildProjectDirectory)/../../LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="$(MSBuildProjectDirectory)/../../icon.png" Condition="Exists('$(MSBuildProjectDirectory)/../../icon.png')" Pack="true" PackagePath="icon.png" />
  </ItemGroup>
</Project>

